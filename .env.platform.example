# Keep the existing homepage Supabase configuration unchanged.
# Apply ONLY supabase/migrations/20261006070000_platform.sql first.
# Then set this in the deployment environment and rebuild the app.
VITE_PLATFORM_BACKEND_ENABLED=false
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
# Never put a service_role key, database password, or management token in VITE_*.
