# Server-side secrets only. Configure on Supabase functions, never in VITE_*.
# Test mode is enforced by the billing functions.
STRIPE_SECRET_KEY=sk_test_REPLACE
STRIPE_WEBHOOK_SECRET=whsec_REPLACE
APP_URL=https://catalystintro.com
STRIPE_PRICE_PRO_FOUNDER_MONTHLY=price_REPLACE
STRIPE_PRICE_PRO_FOUNDER_YEARLY=price_REPLACE
STRIPE_PRICE_PRO_INVESTOR_MONTHLY=price_REPLACE
STRIPE_PRICE_PRO_INVESTOR_YEARLY=price_REPLACE
STRIPE_PRICE_CONCIERGE_ONE=price_REPLACE
STRIPE_PRICE_CONCIERGE_TWO=price_REPLACE
STRIPE_PRICE_MESSAGES_THREE=price_REPLACE
STRIPE_PRICE_MESSAGES_SIX=price_REPLACE
STRIPE_CONCIERGE_PRO_COUPON=REPLACE_20_PERCENT_UNRESTRICTED
# Standard SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are function runtime secrets.
# Optional public display settings, must match confirmed Stripe prices.
VITE_PRO_FOUNDER_PRICE=29
VITE_PRO_INVESTOR_PRICE=19
